<launch>

  <arg name="interface" default="eth4" />
  <arg name="receiver_timeout_sec" default="0.2" />
  <arg name="sender_timeout_sec" default="0.2" />
  <arg name="enable_can_fd" default="false" />

  <include file="$(find-pkg-share zf_hal_can_driver)/launch/hal_can_driver.launch.py">
    <arg name="interface" value="$(var interface)" />
    <arg name="timeout_sec" value="$(var receiver_timeout_sec)" />
    <arg name="enable_can_fd" value="$(var enable_can_fd)" />
  </include>

</launch>
